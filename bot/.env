# Renomeie este arquivo para ".env" e preencha com os dados do seu bot
# (Discord Developer Portal -> sua aplicação)

DISCORD_TOKEN=coloque_o_token_do_bot_aqui
CLIENT_ID=coloque_o_application_id_aqui

# Opcional: se preenchido, os comandos aparecem instantaneamente NESSE
# servidor (ideal para testar). Deixe em branco para registro global
# (funciona em todos os servidores, mas demora até 1h para aparecer).
GUILD_ID=

# Monitor do servidor Minecraft/Aternos (somente o domínio principal fica aqui;
# o bot resolve o SRV e mostra publicamente apenas o host *.aternos.host:porta)
ATERNOS_DOMAIN=MineEmpiresOf.aternos.me:13174
SERVER_STATUS_CHANNEL_ID=980951220502003753
SERVER_CHECK_INTERVAL_MS=5000
