# Discord
DISCORD_TOKEN=coloque_o_token_do_bot_aqui
CLIENT_ID=coloque_o_application_id_aqui
GUILD_ID=

# Aternos Watcher
# O host principal é usado pelo probe do proxy Aternos.
ATERNOS_WATCHER_HOST=MineEmpiresOf.aternos.me
# Porta do endpoint principal/proxy. Não é a porta dinâmica do DynIP.
ATERNOS_WATCHER_PORT=25565
# Compatibilidade com a configuração antiga:
ATERNOS_DOMAIN=MineEmpiresOf.aternos.me

# Canal onde as mudanças de estado são anunciadas
SERVER_STATUS_CHANNEL_ID=980951220502003753

# Polling (segundos, como no Aternos Watcher original)
ATERNOS_WATCHER_UPDATE_TIME=30

# Confirmação/debounce
ATERNOS_WATCHER_CONFIRM_READINGS=2
ATERNOS_WATCHER_STARTING_CONFIRM_READINGS=1
ATERNOS_WATCHER_OPEN_CONFIRM_DELAY_MS=5000

# Consulta Minecraft
ATERNOS_WATCHER_QUERY_TIMEOUT_MS=8000
ATERNOS_WATCHER_QUERY_ATTEMPTS=1
ATERNOS_WATCHER_QUERY_RETRY_DELAY_MS=750
ATERNOS_WATCHER_MAX_SRV_ENDPOINTS=6

# Logs
ATERNOS_WATCHER_VERBOSE=true

# DNS adicional para descobrir o SRV quando o resolver padrão falhar.
SERVER_DNS_SERVERS=1.1.1.1,8.8.8.8

# Personalização de embeds
ATERNOS_WATCHER_ONLINE_TITLE=🟢 Server ONLINE!
ATERNOS_WATCHER_OFFLINE_TITLE=🔴 Server OFFLINE
ATERNOS_WATCHER_WAITING_TITLE=⏳ Server WAITING...
ATERNOS_WATCHER_STARTING_TITLE=🟡 Server STARTING...
ATERNOS_WATCHER_STOPPING_TITLE=🛑 Server STOPPING...
ATERNOS_WATCHER_ONLINE_COLOR=30c030
ATERNOS_WATCHER_OFFLINE_COLOR=ff4040
ATERNOS_WATCHER_WAITING_COLOR=ffff00
ATERNOS_WATCHER_STARTING_COLOR=ffff00
ATERNOS_WATCHER_STOPPING_COLOR=ff8c00
ATERNOS_WATCHER_UNKNOWN_COLOR=808080
ATERNOS_WATCHER_WAITING_MESSAGE=A Aternos está aguardando uma conexão ao servidor.
ATERNOS_WATCHER_MENTION=
ATERNOS_WATCHER_AUTHOR_NAME=
ATERNOS_WATCHER_AUTHOR_ICON=
ATERNOS_WATCHER_AUTHOR_URL=
ATERNOS_WATCHER_FOOTER_TEXT=Aternos Watcher
ATERNOS_WATCHER_FOOTER_ICON=
ATERNOS_WATCHER_THUMBNAIL_URL=
ATERNOS_WATCHER_SHOW_MOTD=true
ATERNOS_WATCHER_SHOW_PLAYERS=true
